{
  "openapi": "3.0.3",
  "info": { "title": "Acme Payments API", "version": "2.1.0" },
  "security": [{ "apiKey": [] }],
  "components": {
    "securitySchemes": {
      "apiKey": { "type": "apiKey", "in": "header", "name": "X-API-Key" },
      "legacyBasic": { "type": "http", "scheme": "basic" }
    },
    "schemas": {
      "Money": {
        "type": "object",
        "required": ["amount_cents", "currency"],
        "properties": {
          "amount_cents": { "type": "integer" },
          "currency": { "type": "string" }
        }
      },
      "Invoice": {
        "type": "object",
        "required": ["id", "status", "total"],
        "properties": {
          "id": { "type": "string" },
          "status": { "type": "string", "enum": ["draft", "open", "paid", "void"] },
          "total": { "$ref": "#/components/schemas/Money" },
          "lines": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "sku": { "type": "string" },
                "quantity": { "type": "integer" },
                "unit": { "$ref": "#/components/schemas/Money" }
              },
              "required": ["sku", "quantity"]
            }
          }
        }
      },
      "InvoiceList": {
        "type": "object",
        "properties": {
          "invoices": { "type": "array", "items": { "$ref": "#/components/schemas/Invoice" } },
          "has_more": { "type": "boolean" }
        },
        "required": ["invoices"]
      }
    }
  },
  "paths": {
    "/v2/invoices": {
      "parameters": [
        { "name": "X-Request-Id", "in": "header", "required": false, "schema": { "type": "string" } }
      ],
      "get": {
        "operationId": "listInvoices",
        "parameters": [
          { "name": "limit", "in": "query", "required": false, "schema": { "type": "integer" } },
          { "name": "status", "in": "query", "required": false, "schema": { "type": "string", "enum": ["draft", "open", "paid", "void"] } }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/InvoiceList" } } }
          },
          "206": {
            "description": "Partial (deprecated)",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/InvoiceList" } } }
          }
        }
      },
      "post": {
        "operationId": "createInvoice",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["customer_id"],
                "properties": {
                  "customer_id": { "type": "string" },
                  "memo": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Invoice" } } }
          }
        }
      }
    },
    "/v2/invoices/{id}": {
      "get": {
        "operationId": "getInvoice",
        "deprecated": false,
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Invoice" } } }
          }
        }
      }
    },
    "/v2/payouts": {
      "get": {
        "operationId": "listPayouts",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "payouts": { "type": "array", "items": { "type": "object", "properties": { "id": { "type": "string" } } } } }
                }
              }
            }
          }
        }
      }
    }
  }
}
